# Copy to .env.local only if it does not exist; otherwise merge these values manually.
# Next.js loads .env.local automatically. It does NOT load .env.sandbox.example.
# Keep the browser and authenticated API proxy local; expose only the backend IPN via tunnel.
BACKEND_URL=http://localhost:8080
# Google sign-in is optional for payment tests. Use email/password when this is blank.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# No VNPAY_HASH_SECRET or merchant credentials belong in this repository.
# Payments are enabled/disabled by the BACKEND, not by a frontend environment flag.
